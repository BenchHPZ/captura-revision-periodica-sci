# Copiar a .env.local y llenar con los valores del proyecto de Supabase
# (Panel del proyecto → Project Settings → API).

# Dirección del proyecto. Pública.
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública ("anon"). Opera bajo las políticas de seguridad por
# renglón (RLS); segura de exponer en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio ("service_role"). Sólo para las utilerías locales en
# scripts/ (carga de catálogo, generación del informe). Nunca se usa en
# código que corre en el navegador o en la aplicación desplegada.
SUPABASE_SERVICE_ROLE_KEY=
